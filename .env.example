DATABASE_URL=postgresql://user:password@localhost:5432/ipcha
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Vercel Blob — leave unset in local dev to use local disk storage instead
BLOB_READ_WRITE_TOKEN=

# Resend — leave unset in local dev to log emails to console instead
RESEND_API_KEY=
RESEND_FROM=noreply@ipcha.org.il
